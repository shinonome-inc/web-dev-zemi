# ── Database (Neon / Postgres) ───────────────────────────
# Neonのプロジェクト作成後に表示される接続文字列。
# 例: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ── Auth.js ──────────────────────────────────────────────
# セッション署名用のシークレット。生成: `pnpm dlx auth secret` または `openssl rand -base64 32`
AUTH_SECRET=

# 本番URL（ローカルでは未設定でOK。デプロイ時に設定）
# AUTH_URL=https://your-portal.example.com

# ── Mastodon（主ログイン）────────────────────────────────
# コミュニティのインスタンスURL（例: https://mastodon.example）
MASTODON_INSTANCE=
# インスタンスの「開発」からアプリ登録して発行。
# リダイレクトURI: <APP_URL>/api/auth/callback/mastodon
#   ローカル例: http://localhost:3000/api/auth/callback/mastodon
# 必要スコープ: read:accounts
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# ── Google（任意・フォールバック）────────────────────────
# 設定した場合のみログイン候補に表示される。
# リダイレクトURI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
